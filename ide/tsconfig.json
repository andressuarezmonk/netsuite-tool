{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vscode"],
    "paths": {
      "@/*": ["./src/*"],
      "@protocol": ["../protocol/protocol.ts"]
    }
  },
  "include": ["src"]
}
