{
  "name": "netsuite-fast-tracker-vscode",
  "displayName": "NetSuite Fast Time Tracker",
  "description": "See and log your NetSuite hours from VS Code",
  "version": "0.0.1",
  "private": true,
  "publisher": "netsuite-fast-tracker",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "netsuiteTracker",
          "title": "NetSuite Time",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "netsuiteTracker": [
        {
          "id": "netsuiteTracker.week",
          "name": "This Week",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "netsuiteTracker.pair",
        "title": "Pair with Chrome",
        "category": "NetSuite Tracker"
      },
      {
        "command": "netsuiteTracker.refresh",
        "title": "Refresh",
        "category": "NetSuite Tracker",
        "icon": "$(refresh)"
      },
      {
        "command": "netsuiteTracker.previousWeek",
        "title": "Previous Week",
        "category": "NetSuite Tracker",
        "icon": "$(chevron-left)"
      },
      {
        "command": "netsuiteTracker.nextWeek",
        "title": "Next Week",
        "category": "NetSuite Tracker",
        "icon": "$(chevron-right)"
      },
      {
        "command": "netsuiteTracker.currentWeek",
        "title": "Go to Current Week",
        "category": "NetSuite Tracker",
        "icon": "$(calendar)"
      },
      {
        "command": "netsuiteTracker.logHours",
        "title": "Log Hours\u2026",
        "category": "NetSuite Tracker",
        "icon": "$(add)"
      },
      {
        "command": "netsuiteTracker.openNetSuite",
        "title": "Open NetSuite",
        "category": "NetSuite Tracker",
        "icon": "$(globe)"
      },
      {
        "command": "netsuiteTracker.openInEditor",
        "title": "Open Week in Editor",
        "category": "NetSuite Tracker",
        "icon": "$(link-external)"
      },
      {
        "command": "netsuiteTracker.resetPairing",
        "title": "Reset Pairing\u2026",
        "category": "NetSuite Tracker"
      },
      {
        "command": "netsuiteTracker.openWebReleases",
        "title": "Get the Chrome Extension",
        "category": "NetSuite Tracker"
      },
      {
        "command": "netsuiteTracker.openIdeReleases",
        "title": "Get the VS Code Extension Releases",
        "category": "NetSuite Tracker"
      },
      {
        "command": "netsuiteTracker.checkForUpdates",
        "title": "Check for Updates",
        "category": "NetSuite Tracker"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "netsuiteTracker.logHours",
          "when": "view == netsuiteTracker.week && netsuiteTracker.viewState == ready",
          "group": "navigation@0"
        },
        {
          "command": "netsuiteTracker.refresh",
          "when": "view == netsuiteTracker.week",
          "group": "navigation@1"
        },
        {
          "command": "netsuiteTracker.openInEditor",
          "when": "view == netsuiteTracker.week",
          "group": "navigation@2"
        },
        {
          "command": "netsuiteTracker.pair",
          "when": "view == netsuiteTracker.week",
          "group": "1_connection@1"
        },
        {
          "command": "netsuiteTracker.openNetSuite",
          "when": "view == netsuiteTracker.week",
          "group": "1_connection@2"
        },
        {
          "command": "netsuiteTracker.resetPairing",
          "when": "view == netsuiteTracker.week",
          "group": "1_connection@3"
        },
        {
          "command": "netsuiteTracker.checkForUpdates",
          "when": "view == netsuiteTracker.week",
          "group": "2_help@1"
        }
      ]
    },
    "configuration": {
      "title": "NetSuite Tracker",
      "properties": {
        "netsuiteTracker.port": {
          "type": "number",
          "default": 8765,
          "minimum": 1024,
          "maximum": 65535,
          "markdownDescription": "Local port the Chrome extension connects to. Pair again after changing it."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "package": "vsce package --no-dependencies --skip-license",
    "release:ide": "bash ../scripts/release-ide.sh"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.90.0",
    "@types/ws": "^8.18.2",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.25.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0",
    "ws": "^8.23.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andressuarezmonk/netsuite-tool.git",
    "directory": "ide"
  },
  "homepage": "https://github.com/andressuarezmonk/netsuite-tool#readme"
}
